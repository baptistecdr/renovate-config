{
  "extends": [
    "config:best-practices",
    ":pinVersions",
    ":timezone(Europe/Paris)"
  ],
  "assignees": [
    "baptistecdr"
  ],
  "git-submodules": {
    "enabled": true
  },
  "terraform": {
    "pinDigests": true
  },
  "minimumReleaseAge": "2 days",
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 7am on the first day of the month"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "pin",
        "digest",
        "pinDigest",
        "minor",
        "patch"
      ],
      "automerge": true,
      "schedule": [
        "before 7am"
      ]
    },
    {
      "description": "What gets deployed or runs in CI (images, Terraform providers, Actions, playbooks, submodules) is reviewed by hand, never merged unattended",
      "matchManagers": [
        "ansible",
        "ansible-galaxy",
        "docker-compose",
        "dockerfile",
        "git-submodules",
        "github-actions",
        "terraform"
      ],
      "automerge": false
    },
    {
      "description": "Update types without a release timestamp would wait forever for minimumReleaseAge",
      "matchUpdateTypes": [
        "bump",
        "lockFileMaintenance",
        "lockfileUpdate",
        "pin",
        "replacement",
        "rollback"
      ],
      "minimumReleaseAge": null
    },
    {
      "matchPackageNames": ["react", "react-dom"],
      "groupName": "react packages"
    }
  ]
}
